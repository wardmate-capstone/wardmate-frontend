# Copy to .env.development.local for local FE http://localhost:5173.
# API origin only: do not append /swagger/index.html or /api/v1/auth.
# Never put authentication tokens/API secrets in VITE_ variables. Configure production separately.
VITE_API_BASE_URL=https://wardmate-iam.blackmeadow-a2f12767.japaneast.azurecontainerapps.io

# Public Web Analytics site identifier, NOT a Cloudflare API token.
# Set in production hosting build variables; blank disables Analytics.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
