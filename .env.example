# API origins: do not append /swagger/index.html or /api/v1/auth.
# Backend origins. Do not append Swagger paths or /api/v1.
# Configure the same variables in local .env files and the deployment environment.
# true: browser calls same-origin /api and the dev/hosting proxy uses the targets below.
# false: browser calls each service origin directly; CORS and refresh cookie must support it.
VITE_USE_API_PROXY=true
VITE_API_BASE_URL=https://wardmate-iam.blackmeadow-a2f12767.japaneast.azurecontainerapps.io
VITE_CATALOG_API_URL=https://wardmate-procedure-catalog.blackmeadow-a2f12767.japaneast.azurecontainerapps.io
VITE_WORKFLOW_API_URL=https://wardmate-application-workflow.blackmeadow-a2f12767.japaneast.azurecontainerapps.io
VITE_DOCUMENT_FORM_API_URL=https://wardmate-gateway.blackmeadow-a2f12767.japaneast.azurecontainerapps.io
VITE_ANALYTICS_API_URL=https://wardmate-gateway.blackmeadow-a2f12767.japaneast.azurecontainerapps.io

# Public Web Analytics site identifier, NOT a Cloudflare API token.
# Set in production hosting build variables; blank disables Analytics.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
