# API origins: do not append /swagger/index.html or /api/v1/auth.
# In local development (empty VITE_*_API_URL), Vite dev server proxies:
#   /api/v1/auth, /api/v1/users, /api/v1/accounts -> IAM Container App
#   /api/v1/procedures, /api/v1/procedure-manager -> Procedure Catalog Container App
#   /api/v1/form-templates -> Gateway -> Document Form
# Leave blank with Vite/Vercel same-origin proxy/rewrite configuration.
# For standalone hosting, configure a Gateway origin serving IAM AND Document Form,
# plus browser CORS/cookies; do not use the IAM-only origin as the shared API base.
VITE_API_BASE_URL=
VITE_CATALOG_API_URL=

# Public Web Analytics site identifier, NOT a Cloudflare API token.
# Set in production hosting build variables; blank disables Analytics.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
