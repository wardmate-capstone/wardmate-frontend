# API origins: do not append /swagger/index.html or /api/v1/auth.
# Backend origins. Do not append Swagger paths or /api/v1.
# Configure the same variables in local .env files and the deployment environment.
# true: browser calls same-origin /api and the dev/hosting proxy uses the targets below.
# false: browser calls each service origin directly; CORS and refresh cookie must support it.
VITE_USE_API_PROXY=true
# Since 20/11/2026 every service (IAM, catalog, workflow, document-form, analytics, SignalR hub) is served
# through the single Azure gateway; keep all five variables pointing at it.
VITE_API_BASE_URL=https://wardmate-gateway.bravetree-f6485744.japaneast.azurecontainerapps.io
VITE_CATALOG_API_URL=https://wardmate-gateway.bravetree-f6485744.japaneast.azurecontainerapps.io
VITE_WORKFLOW_API_URL=https://wardmate-gateway.bravetree-f6485744.japaneast.azurecontainerapps.io
VITE_DOCUMENT_FORM_API_URL=https://wardmate-gateway.bravetree-f6485744.japaneast.azurecontainerapps.io
VITE_ANALYTICS_API_URL=https://wardmate-gateway.bravetree-f6485744.japaneast.azurecontainerapps.io
